%% A small gen_server showcasing Angler syntax.
%% After `make`, from the project root:
%%   mkdir -p _build/example
%%   bin/angler transpile example/example.erlx > _build/example/example.erl
%%   erlc -Werror -o _build/example _build/example/example.erl
%%   erl -noshell -pa _build/example -eval '{ok, _} = example:start(), ok = example:stop(), halt().'
%% Optionally format the output: rebar3 fmt -w _build/example/example.erl

-module(example).
-behaviour(gen_server).

-record(address, {city}).
-record(person, {name, age, address}).

%% Standard exports remain valid; gen_server also requires this callback.
-export([handle_cast/2]).

_export(api) % Adds start/0 to the export group labeled %% api.
start() :: {ok, pid()} | {error, term()} -> % Emits -spec start() -> {ok, pid()} | {error, term()}.
    gen_server:start_link({local, ?MODULE}, ?MODULE, [], []).

_export(api) % Adds stop/0 to the same export group.
stop() :: ok -> % Emits -spec stop() -> ok.
    %% Function results need an explicit local record annotation, erased in output.
    P :: #person{} = gen_server:call(?MODULE, birthday),
    Alias = P, % Aliases inherit the known record name.
    42 = Alias.age, % Becomes Alias#person.age.
    "Rome" = city(P),
    <<"42">> = encode(42),
    <<"hello">> = encode(<<"hello">>),
    gen_server:stop(?MODULE).

_export(gen_server) % Adds init/1 to the export group labeled %% gen_server.
init(Args :: list()) :: {ok, #person{}} -> % Emits -spec init(list()) -> {ok, #person{}}.
    [] = Args,
    P = #person{ % Direct construction establishes P's record name.
        name = "Ada",
        age = 41,
        address = #address{city = "Rome"}
    },
    {ok, P}.

_export(gen_server) % Adds handle_call/3 to the same export group.
%% Emits -spec handle_call(atom(), any(), #person{}) -> {reply, #person{}, #person{}}.
%% The unannotated _From defaults to any() in this otherwise typed head.
handle_call(Request :: atom(), _From, State :: #person{}) :: {reply, #person{}, #person{}} ->
    birthday = Request,
    Next = State{age = State.age + 1}, % Becomes State#person{age = State#person.age + 1}.
    {reply, Next, Next}.

%% No argument or return annotations: no -spec is generated.
handle_cast(_Request, State) ->
    {noreply, State}.

city(P :: #person{}) :: string() -> % Emits -spec city(#person{}) -> string().
    A :: #address{} = P.address, % Field values need an explicit record annotation.
    A.city.

%% Emits one overloaded spec for both clauses:
%% -spec encode(integer()) -> binary(); (binary()) -> binary().
encode(N :: integer()) :: binary() when is_integer(N) ->
    integer_to_binary(N);
encode(B :: binary()) :: binary() when is_binary(B) ->
    B.
