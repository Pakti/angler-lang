%% Angler: rebar3 compile | shell | eunit | fmt
{erl_opts, [debug_info, warnings_as_errors]}.
{deps, []}.

%% Fixtures contain example modules, not EUnit suites.
{eunit_tests, [
    {module, ext_roundtrip_tests},
    {module, ext_exports_tests},
    {module, ext_snippet_tests},
    {module, ext_types_tests},
    {module, ext_records_tests}
]}.

{profiles, [
    {fast, [{erl_opts, [no_debug_info]}]}
]}.

{compiler_error_format, minimal}.

{project_plugins, [{erlfmt, "1.8.0"}]}.
{erlfmt, [
    {files, [
        "src/*.erl",
        "src/*.app.src",
        "test/*.erl",
        "test/fixtures/*.erl",
        "test/fixtures/*.hrl",
        "rebar.config"
    ]}
]}.
